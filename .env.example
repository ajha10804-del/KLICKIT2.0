# =============================================================================
# KLICKIT Production & Development Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit the actual .env file containing real secrets to version control.
# =============================================================================

# Database Configuration (PostgreSQL / Neon - append ?sslmode=require for Neon)
DB_URL=jdbc:postgresql://localhost:5432/klickit
DB_USERNAME=klickit
DB_PASSWORD=

# Server Port (Render sets PORT automatically)
PORT=8080

# Security / JWT Secret (Base64-encoded key of at least 256 bits)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Passwordless Email OTP Authentication
OTP_SECRET=
OTP_ENABLED=true
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# Administrator & Notification Destination
ADMIN_EMAIL=

# Bootstrap Admin (set once for first deployment, then REMOVE BOOTSTRAP_ADMIN_PASSWORD from the host environment)
BOOTSTRAP_ADMIN_NAME=KlickIt Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# SEED_DEMO_PRODUCTS=false  (true = insert six fake demo products on boot; never in production)

# Transactional Email (Resend HTTPS API)
# Resend default sandbox sender delivers to the verified account owner email
MAIL_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_API_URL=https://api.resend.com/emails
MAIL_TIMEZONE=Asia/Kolkata

# CORS Allowed Origins (Comma-separated exact URLs with no trailing slash)
CORS_ALLOWED_ORIGINS=

# Road Routing & Driving Distance Verification (OpenRouteService API)
KLICKIT_ROUTING_API_KEY=
ROUTING_ENABLED=true
# Optional routing overrides:
# ROUTING_PROVIDER=openrouteservice
# ROUTING_BASE_URL=https://api.openrouteservice.org
# ROUTING_CONNECT_TIMEOUT_MS=3000
# ROUTING_REQUEST_TIMEOUT_MS=3000
# ROUTING_MAX_DISTANCE_METERS=5000

# Cart Expiration & Maintenance (stale guest/customer carts purge window)
CART_RETENTION_DAYS=30
CART_CLEANUP_CRON=0 0 3 * * ?

# Swagger / OpenAPI documentation (default: false in production, true in dev profile)
SWAGGER_ENABLED=false

# Frontend Configuration (Vercel Build-time Public Variable - e.g. https://klickit-backend.onrender.com; NO trailing slash, must NOT end in /api)
VITE_API_BASE_URL=
